---
/** Spoiler protection is a before/after, so it gets a before/after. */
import Shot from './Shot.astro';
import { THUMB } from '../data/imageSizes';
---

<div class="spoillab" data-spoillab>
  <div class="spoillab-stage">
    <div class="spoillab-card" data-spoillab-card data-hidden="true">
      <div class="spoillab-thumb">
        <Shot
          name="plozz-demo-tv-detail"
          alt="An episode thumbnail, blurred while the episode is unwatched"
          sizes={THUMB}
          fetchpriority="low"
          defer="viewport"
        />
      </div>
      <p class="spoillab-title" data-spoillab-title>Episode 4</p>
      <p class="spoillab-sub" data-spoillab-sub>Hidden until you’ve watched it</p>
    </div>
  </div>

  <fieldset class="spoillab-controls">
    <legend>Spoiler protection</legend>
    <div class="spoillab-options">
      <label class="sublab-option">
        <input type="radio" name="spoillab" value="true" checked data-spoillab-toggle />
        <span>On</span>
      </label>
      <label class="sublab-option">
        <input type="radio" name="spoillab" value="false" data-spoillab-toggle />
        <span>Off</span>
      </label>
    </div>
  </fieldset>
</div>

<script>
  document.querySelectorAll('[data-spoillab]').forEach((lab) => {
    const card = lab.querySelector('[data-spoillab-card]');
    const title = lab.querySelector('[data-spoillab-title]');
    const sub = lab.querySelector('[data-spoillab-sub]');

    const apply = () => {
      const choice = lab.querySelector('[data-spoillab-toggle]:checked');
      const hidden = !choice || choice.value === 'true';
      card.dataset.hidden = String(hidden);
      title.textContent = hidden ? 'Episode 4' : 'The Long View';
      sub.textContent = hidden ? 'Hidden until you’ve watched it' : 'Shown once you’ve watched it';
    };

    lab.addEventListener('change', apply);
    apply();
  });
</script>
