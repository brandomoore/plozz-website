---
/**
 * Two rows of screenshots drifting in opposite directions. The track is
 * rendered twice so the loop is seamless; the duplicate is hidden from
 * assistive tech.
 *
 * Rows are ordered so no two shots of the same device sit next to each other,
 * including across the loop seam. The iPad and iPhone shots are spaced evenly
 * through the Apple TV ones so they read as punctuation rather than a clump.
 *
 * Tiles never paint wider than 540 CSS px, so these ladders top out at 1080 and
 * a phone pulls the 360px rung instead of a full-size screenshot.
 *
 * They also load at low priority. Native lazy loading is not enough on a slow
 * connection: the browser widens its lazy threshold when bandwidth is scarce,
 * so all sixteen tiles used to start downloading a second into the page and
 * split the pipe with the hero, dragging LCP out to 44s on Slow 3G.
 */
import Shot from './Shot.astro';
import { MARQUEE, MARQUEE_PORTRAIT } from '../data/imageSizes';

/** The tall iPhone tiles paint about a quarter as wide as the landscape ones. */
const PORTRAIT = new Set(['plozz-demo-iphone-home', 'plozz-demo-iphone-library']);
const sizesFor = (name: string) => name === 'plozz-demo-ipad-home'
  ? '(max-width: 908px) 150px, (max-width: 1363px) 16.5vw, 225px'
  : (PORTRAIT.has(name) ? MARQUEE_PORTRAIT : MARQUEE);

const rowOne = [
  { name: 'plozz-demo-tv-home', alt: 'Licensed film artwork in Plozz on Apple TV' },
  { name: 'plozz-demo-ipad-home', alt: 'Sol Levante and Continue Watching on iPad' },
  { name: 'plozz-demo-tv-library', alt: 'A populated film library on Apple TV' },
  { name: 'plozz-demo-iphone-home', alt: 'Sol Levante and Continue Watching on iPhone' },
];

const rowTwo = [
  { name: 'plozz-demo-tv-subtitles', alt: 'Subtitle styling during Wing It!' },
  { name: 'plozz-demo-iphone-library', alt: 'Licensed film artwork in the iPhone library' },
  { name: 'plozz-demo-tv-resume', alt: 'Several films in Continue Watching on Apple TV' },
  { name: 'plozz-demo-tv-player', alt: 'Playback controls during Wing It! on Apple TV' },
];
---

<section class="marquee" aria-label="Plozz on Apple TV, iPhone and iPad" data-lazy-group>
  <div class="marquee-row">
    <div class="marquee-track">
      {[0, 1].map((pass) =>
        rowOne.map((shot) => (
          <Shot
            name={shot.name}
            alt={pass === 0 ? shot.alt : ''}
            sizes={sizesFor(shot.name)}
            fetchpriority="low"
            defer="viewport"
            ariaHidden={pass === 1}
          />
        ))
      )}
    </div>
  </div>

  <div class="marquee-row">
    <div class="marquee-track is-reverse">
      {[0, 1].map((pass) =>
        rowTwo.map((shot) => (
          <Shot
            name={shot.name}
            alt={pass === 0 ? shot.alt : ''}
            sizes={sizesFor(shot.name)}
            fetchpriority="low"
            defer="viewport"
            ariaHidden={pass === 1}
          />
        ))
      )}
    </div>
  </div>
</section>
