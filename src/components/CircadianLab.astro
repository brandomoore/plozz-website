---
/** Just the screen. The dial that explains it lives in the next cell. */
import Shot from './Shot.astro';
import { FIGURE } from '../data/imageSizes';
---

<div class="sky">
  <div class="sky-screen">
    <Shot
      name="plozz-demo-tv-player"
      alt="A bright daytime scene playing in Plozz, warming and dimming as evening falls"
      sizes={FIGURE}
      fetchpriority="low"
      defer="viewport"
    />
    <span class="sky-tint" aria-hidden="true"></span>
  </div>
</div>
