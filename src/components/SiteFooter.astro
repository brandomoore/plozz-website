---
import { Icon } from 'astro-icon/components';
import { GITHUB_URL, DONATE_URL, DISCORD_URL, SERVER_LINKS, NAV_LINKS, GITHUB_STARS_SEED } from '../data/site';
import { LOGO_PATH } from '../data/brand';
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <a class="footer-brand" href="/" aria-label="Plozz home">
        <img src={LOGO_PATH} alt="" width="22" height="22" />
        <span>Plozz</span>
      </a>

      <nav class="footer-nav" aria-label="Footer navigation">
        <div>
          <h2>Servers</h2>
          <ul>
            {SERVER_LINKS.map((link) => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
          </ul>
        </div>
        <div>
          <h2>The app</h2>
          <ul>
            {NAV_LINKS.map((link) => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
            <li><a href="/apple-tv-media-players">Compare players</a></li>
            <li><a href="/privacy">Privacy</a></li>
            <li><a href="/media-credits">Media credits</a></li>
          </ul>
        </div>
        <div>
          <h2>Project</h2>
          <ul>
            <li>
              <a class="github-link" href={GITHUB_URL} target="_blank" rel="noopener">
                <Icon name="simple-icons:github" />
                <span class="sr-only">GitHub</span>
                <span class="github-stars" data-github-stars-badge aria-label={`${GITHUB_STARS_SEED} GitHub stars`}>
                  <span data-github-stars>{GITHUB_STARS_SEED}</span>
                  <span>stars</span>
                </span>
              </a>
            </li>
            <li>
              <a class="discord-link" href={DISCORD_URL} target="_blank" rel="noopener">
                <Icon name="simple-icons:discord" aria-hidden="true" />
                Discord
              </a>
            </li>
            <li><a href={`${GITHUB_URL}/issues`} target="_blank" rel="noopener">Send feedback</a></li>
            <li><a href={DONATE_URL} target="_blank" rel="noopener">Donate</a></li>
          </ul>
        </div>
      </nav>
    </div>

    <div class="footer-base">
      <span>© {new Date().getFullYear()} Plozz</span>
      <span>GPL-3.0</span>
    </div>
  </div>
</footer>

<style>
  .discord-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    margin: -8px;
    padding: 8px;
    border-radius: var(--r-sm);
  }

  .discord-link :global(svg) {
    width: 18px;
    height: 18px;
    flex: none;
  }
</style>
