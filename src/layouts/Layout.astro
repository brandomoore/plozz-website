---
import '../styles/global.css';
import FontPreview from '../components/FontPreview.astro';

/** A build-time try-on rig for typefaces, off unless explicitly asked for.
    `npm run fonts` sets this; a normal build never renders the component, so
    the shipped pages carry no webfont request and no switcher. */
const fontPreview = import.meta.env.PLOZZ_FONT_PREVIEW === '1';

export interface Props {
  title?: string;
  description?: string;
  /** Error pages should stay out of the index even though the status code
      already says so — a stray crawl of the URL should not add it. */
  noindex?: boolean;
}
const {
  title = 'Plozz — Jellyfin, Plex, Emby & Silo for Apple TV, iPhone & iPad',
  description = 'A free, open source player for Jellyfin, Plex, Emby, Silo and network shares. Apple TV, iPhone and iPad, with mobile downloads and streaming-quality controls.',
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;

/** Describes the card at public/og-image.png, so the two say the same thing.
    Both are built from tools/build-og.mjs — change the words in one place. */
const socialImageAlt =
  'Plozz — free, open source player for Jellyfin, Plex, Emby, Silo and network shares on Apple TV, iPhone and iPad';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta
      name="robots"
      content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'}
    />
    <meta name="author" content="Brandon Moore" />
    <meta name="theme-color" content="#0a0c10" />

    {/* The headline is the LCP on every page and it is set in Manrope, so the
        font is fetched alongside the stylesheet rather than after it. One file,
        latin subset, covering the whole 400–700 range. */}
    <link
      rel="preload"
      href="/fonts/manrope-v20-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og-image.png', Astro.site).href} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta property="og:site_name" content="Plozz" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/og-image.png', Astro.site).href} />
    <meta name="twitter:image:alt" content={socialImageAlt} />

    <!-- Pages that own their LCP image preload it here, where the parser meets
         it before the markup that uses it. -->
    <slot name="head" />

    {fontPreview && <FontPreview />}
  </head>
  <body>
    <slot />
  </body>
</html>
