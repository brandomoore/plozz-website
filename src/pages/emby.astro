---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Closer from '../components/Closer.astro';
import SiteScripts from '../components/SiteScripts.astro';
import PageHero from '../components/PageHero.astro';
import Showcase from '../components/Showcase.astro';
import FactSection from '../components/FactSection.astro';
import Shot from "../components/Shot.astro";
import { FIGURE } from "../data/imageSizes";
import { DOCS_URL } from '../data/site';

const title = "Emby client for Apple TV, iPhone and iPad — Plozz";
const description = "A free Emby client for Apple TV, iPhone and iPad. Native libraries and playback, mobile streaming quality and downloads, version switching and subtitle search.";

const compatibility = [
  {
    "name": "Video",
    "chips": [
      "HEVC",
      "H.264",
      "VP9",
      "AV1"
    ]
  },
  {
    "name": "HDR",
    "chips": [
      "HDR10",
      "HLG"
    ]
  },
  {
    "name": "Subtitles",
    "chips": [
      "SRT",
      "ASS",
      "SSA",
      "VTT",
      "PGS",
      "DVB",
      "DVD"
    ]
  },
  {
    "name": "One library",
    "value": "Merges with Plex, Jellyfin, Silo and network shares, or keeps its own rows."
  },
  {
    "name": "Hide anything",
    "value": "Any library can leave Home and Search without disconnecting."
  }
];
---

<Layout title={title} description={description}>
  <SiteHeader />

  <main>
    <PageHero
      eyebrow={"Emby"}
      title={"Emby, not an afterthought."}
    />

    <Showcase
      question={"Does it play the original?"}
      detail="Plozz handles compatible original files on the device. On iPhone and iPad, quality limits can ask Emby to convert instead. Server configuration and permissions still apply."
    >
      <ul class="proof">
        <li><span>Dolby Digital Plus Atmos</span><span>E-AC-3 JOC stream copy on compatible paths</span></li>
        <li><span>TrueHD and DTS-HD MA</span><span>Channel-based surround or lossless FLAC</span></li>
        <li><span>Your server</span><span>Delivers the original or a supported conversion</span></li>
      </ul>
    </Showcase>

    <Showcase
      question={"Can I make the subtitles readable?"}
      detail="Style two tracks at once, adjust position in 0.5% steps and search for missing subtitles from the player. Emby-confirmed file matches get their own badge."
      flip
    >
      <Shot
        name="plozz-demo-tv-subtitles"
        alt="Plozz's subtitle style panel during playback of original demo footage"
        sizes={FIGURE}
        class="shot"
      />
    </Showcase>

    <Showcase
      question={"What stays with Emby?"}
    >
      <ul class="proof">
        <li><span>History</span><span>Playback progress and watched state go back to your server</span></li>
        <li><span>Libraries</span><span>Movies, shows and music, with collections and extras</span></li>
        <li><span>Skip markers</span><span>Intros and credits where the server provides them</span></li>
        <li><span>Permissions</span><span>Your Emby user’s access rules still apply</span></li>
      </ul>
    </Showcase>

    <FactSection
      title="At home or away"
      facts={[
        { name: 'Mobile streaming quality', value: 'Movie and episode presets or independent resolution and total-bitrate limits on iPhone/iPad. Save defaults per Plozz profile and network category; player changes are temporary.' },
        { name: 'Conversion limits', value: 'Automatic, Prefer HEVC or Prefer H.264 where supported. Emby’s encoder settings and entitlements apply; HDR tone mapping may require Premiere, and conversion success isn’t guaranteed.' },
        { name: 'Offline downloads', value: 'Save films and episodes on iPhone and iPad. These use their own download controls, not the current streaming-quality limit.' },
        { name: 'Files and editions', value: 'Switch on the active Emby account from the TV or mobile player, keeping position and settings. Different cuts can have different timelines.' },
        { name: 'Library navigation', value: 'Jump to a letter in name-sorted individual and combined libraries, with remote-focused navigation on Apple TV.' },
        { name: 'Clear playback facts', value: 'Current converted-stream formats are separate from the original file. Unknown output never inherits the original’s HDR or Atmos badge.' },
      ]}
    />

    <FactSection
      title="Compatibility"
      facts={compatibility}
    />

    <Closer secondaryHref={`${DOCS_URL}/servers/`} secondaryLabel="Emby setup guide" />
  </main>

  <SiteFooter />
  <SiteScripts />
</Layout>
