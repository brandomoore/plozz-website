---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteScripts from '../components/SiteScripts.astro';
import PageHero from '../components/PageHero.astro';
import Closer from '../components/Closer.astro';
import { FORMAT_TABLE, FORMAT_CAVEATS } from '../data/site';

const title = 'Supported formats — Plozz for Apple TV, iPhone and iPad';
const description =
  'Apple TV height channels from Dolby TrueHD Atmos and DTS:X via AetherEngine. Supported formats, tvOS requirements and how rendered audio reaches your receiver.';

/** Answers the "does it play X" queries people actually type. */
const faqs = [
  {
    q: 'Does Plozz play MKV on Apple TV?',
    a: 'Yes. Plozz can open Matroska files on the device itself. Mobile streaming-quality limits can request a server conversion instead of the original file.',
  },
  {
    q: 'Does Plozz support Dolby Vision?',
    a: 'Yes, profiles 5, 7, 8.1 and 8.4. Profile 7 is the one used by UHD Blu-ray remuxes, and Plozz converts it to Profile 8.1 during playback because Apple hardware cannot decode it directly.',
  },
  {
    q: 'Does Plozz support Dolby Atmos?',
    a: 'Yes. Plozz supports Dolby Digital Plus Atmos (E-AC-3 JOC) on compatible playback paths, plus height-channel rendering from supported Dolby TrueHD Atmos tracks on Apple TV through AetherEngine. The TrueHD path uses Apple Positional Audio and Dolby MAT rather than sending the original TrueHD bitstream.',
  },
  {
    q: 'Does Plozz play DTS:X height channels on Apple TV?',
    a: 'Yes, through AetherEngine’s object-audio rendering path for supported 48 kHz DTS-HD MA tracks with a DTS:X extension. It renders the heights into Apple Positional Audio, delivered by tvOS as Dolby MAT. This requires tvOS 26 or later and compatible Atmos equipment; it is not native DTS:X bitstream output.',
  },
  {
    q: 'Is TrueHD Atmos or DTS:X height playback lossless?',
    a: 'No. The height path renders the source audio and encodes it as Apple Positional Audio (APAC), which is lossy. That is separate from lossless channel-based playback. Unsupported sources or playback paths can fall back to the channel-based bridge without heights.',
  },
  {
    q: 'Does it cost anything?',
    a: 'Plozz is free and open source under GPL-3.0, with no paid format tier. Hardware compatibility and any server-side requirements still apply.',
  },
  {
    q: 'Does Plozz play HDR10+?',
    a: 'Plozz supports HDR10+ metadata in compatible playback paths. Actual output depends on the device, display and stream; an HDR10+ source badge is not proof of HDMI output.',
  },
  {
    q: 'Can it play Blu-ray and DVD images?',
    a: 'Yes, decrypted ISO images, with title and chapter selection.',
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: { '@type': 'Answer', text: faq.a },
  })),
};
---

<Layout title={title} description={description}>
  <SiteHeader />

  <main>
    <PageHero
      eyebrow="Formats"
      title="If it's in your library, it plays."
      lead="Including height-channel audio from Dolby TrueHD Atmos and DTS:X on supported Apple TV setups, powered by AetherEngine."
    />

    <section class="fmt" id="height-channels" aria-labelledby="height-heading">
      <div class="container">
        <div class="fmt-body is-panel">
          <h2 id="height-heading">Hear the height channels.</h2>
          <div class="height-copy">
            <p>
              Plozz supports height-channel playback from Dolby TrueHD Atmos and
              DTS:X on Apple TV. AetherEngine decodes the source’s spatial
              information, renders it into a speaker layout with heights and
              encodes Apple Positional Audio (APAC). tvOS delivers that audio
              to compatible Atmos equipment as Dolby MAT.
            </p>
            <p>
              It’s rendered audio, not untouched TrueHD or DTS:X passthrough.
              APAC is lossy. You need tvOS 26 or later, a supported 48 kHz track
              on the object-audio rendering path and a compatible Atmos receiver
              or soundbar setup. The height path is for supported on-demand video,
              not a promise for every live or software-decoded session.
            </p>
            <p>
              Unsupported tracks or paths can fall back to channel-based audio
              without heights. Server conversion can change the source, and
              receiver labels alone don’t describe the original format.
            </p>
            <p>
              Read AetherEngine’s documentation for <a href="https://github.com/superuser404notfound/AetherEngine/blob/main/docs/formats.md#truehd-atmos-with-heights" target="_blank" rel="noopener">TrueHD Atmos with heights</a> and <a href="https://github.com/superuser404notfound/AetherEngine/blob/main/docs/formats.md#dtsx-with-heights" target="_blank" rel="noopener">DTS:X with heights</a>.
            </p>
          </div>
        </div>
      </div>
    </section>

    {FORMAT_TABLE.map((section) => (
      <section class="fmt" aria-labelledby={section.group.toLowerCase().replace(/[^a-z0-9]+/g, '-')}>
        <div class="container">
          <div class="fmt-body">
            <h2 id={section.group.toLowerCase().replace(/[^a-z0-9]+/g, '-')}>{section.group}</h2>
            <ul class="fmt-rows">
              {section.rows.map((row) => (
                <li>
                  <span class="fmt-name">{row.name}</span>
                  {row.note && <span class="fmt-note">{row.note}</span>}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>
    ))}

    <section class="fmt" aria-labelledby="caveats">
      <div class="container">
        <div class="fmt-body is-panel">
          <h2 id="caveats">Worth knowing</h2>
          <ul class="fmt-rows">
            {FORMAT_CAVEATS.map((caveat) => (
              <li>
                <span class="fmt-name">{caveat.name}</span>
                <span class="fmt-note">{caveat.note}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section class="faq-section" aria-labelledby="faq-heading">
      <div class="container">
        <h2 id="faq-heading">Common questions</h2>
        <div class="faq-list">
          {faqs.map((faq) => (
            <details>
              <summary>{faq.q}</summary>
              <p>{faq.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <Closer secondaryHref="/features" secondaryLabel="The questions people ask" />
  </main>

  <SiteFooter />
  <SiteScripts />

  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
</Layout>

<style>
  #height-channels {
    scroll-margin-top: 100px;
  }

  .height-copy {
    display: grid;
    gap: 16px;
    line-height: 1.6;
    color: var(--text-muted);
  }

  .height-copy a {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .height-copy a:focus-visible {
    outline: 3px solid var(--brand);
    outline-offset: 3px;
  }
</style>
