---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteScripts from '../components/SiteScripts.astro';
import PageHero from '../components/PageHero.astro';
import Closer from '../components/Closer.astro';
import { FORMAT_TABLE, FORMAT_CAVEATS } from '../data/site';

const title = 'Supported formats — Plozz for Apple TV, iPhone and iPad';
const description =
  'Plozz’s supported video, audio, subtitle and disc formats for Apple TV, iPhone and iPad, with device and playback-path requirements.';

/** Answers the "does it play X" queries people actually type. */
const faqs = [
  {
    q: 'Does Plozz play MKV on Apple TV?',
    a: 'Yes. Plozz can open Matroska files on the device itself. Mobile streaming-quality limits can request a server conversion instead of the original file.',
  },
  {
    q: 'Does Plozz support Dolby Atmos?',
    a: 'Plozz supports Dolby Digital Plus Atmos (E-AC-3 JOC) on compatible playback paths. Actual output depends on your device, audio equipment and stream.',
  },
  {
    q: 'Does it cost anything?',
    a: 'Plozz is free and open source under GPL-3.0, with no paid format tier. Hardware compatibility and any server-side requirements still apply.',
  },
  {
    q: 'Does Plozz play HDR10+?',
    a: 'Plozz supports HDR10+ metadata in compatible playback paths. Actual output depends on the device, display and stream; an HDR10+ source badge is not proof of HDMI output.',
  },
  {
    q: 'Can it play Blu-ray and DVD images?',
    a: 'Yes, decrypted ISO images, with title and chapter selection.',
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: { '@type': 'Answer', text: faq.a },
  })),
};
---

<Layout title={title} description={description}>
  <SiteHeader />

  <main>
    <PageHero
      eyebrow="Formats"
      title="If it's in your library, it plays."
      lead="Video, audio, subtitles and disc images, with device and playback-path requirements."
    />

    {FORMAT_TABLE.map((section) => (
      <section class="fmt" aria-labelledby={section.group.toLowerCase().replace(/[^a-z0-9]+/g, '-')}>
        <div class="container">
          <div class="fmt-body">
            <h2 id={section.group.toLowerCase().replace(/[^a-z0-9]+/g, '-')}>{section.group}</h2>
            <ul class="fmt-rows">
              {section.rows.map((row) => (
                <li>
                  <span class="fmt-name">{row.name}</span>
                  {row.note && <span class="fmt-note">{row.note}</span>}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>
    ))}

    <section class="fmt" aria-labelledby="caveats">
      <div class="container">
        <div class="fmt-body is-panel">
          <h2 id="caveats">Worth knowing</h2>
          <ul class="fmt-rows">
            {FORMAT_CAVEATS.map((caveat) => (
              <li>
                <span class="fmt-name">{caveat.name}</span>
                <span class="fmt-note">{caveat.note}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section class="faq-section" aria-labelledby="faq-heading">
      <div class="container">
        <h2 id="faq-heading">Common questions</h2>
        <div class="faq-list">
          {faqs.map((faq) => (
            <details>
              <summary>{faq.q}</summary>
              <p>{faq.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <Closer secondaryHref="/features" secondaryLabel="The questions people ask" />
  </main>

  <SiteFooter />
  <SiteScripts />

  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
</Layout>
