---
import Layout from "../layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Closer from "../components/Closer.astro";
import SiteScripts from "../components/SiteScripts.astro";
import Marquee from "../components/Marquee.astro";
import Confluence from "../components/Confluence.astro";
import CircadianLab from "../components/CircadianLab.astro";
import CircadianDial from "../components/CircadianDial.astro";
import Shot from "../components/Shot.astro";
import { HERO, DEVICE_IPAD, DEVICE_IPHONE } from "../data/imageSizes";
import { shotSrcset } from "../data/shots";
import { INCLUDED, DONATION_AMOUNTS } from "../data/site";
import { GITHUB_URL, DONATE_URL, DISCORD_URL, TESTFLIGHT_URL, SITE } from "../data/site";
import { faqs, stripHtml } from "../data/faqs";
import { SOCIAL_IMAGE_PATH } from "../data/brand";

const heroScreenshots = [
  {
    name: "plozz-demo-tv-home",
    alt: "Plozz on Apple TV with Sol Levante artwork and Continue Watching",
    label: "Home",
  },
  {
    name: "plozz-demo-tv-resume",
    alt: "Plozz's Continue Watching row with several films in progress",
    label: "Continue Watching",
  },
  {
    name: "plozz-demo-tv-library",
    alt: "Plozz's movie library with licensed film artwork",
    label: "Library",
  },
  {
    name: "plozz-demo-tv-player",
    alt: "Plozz's playback controls during Wing It!",
    label: "Playback",
  },];

const softwareLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Plozz",
  applicationCategory: "MultimediaApplication",
  operatingSystem: "tvOS, iOS, iPadOS",
  description:
    "Plozz is a free, open source media and IPTV player for Apple TV, iPhone and iPad. Bring your own M3U playlist or Xtream account, authorized Live TV channels, Jellyfin, Plex, Emby, native Silo or network shares.",
  featureList: [
    "Jellyfin, Plex, Emby and native Silo libraries and playback",
    "SMB, NFS, WebDAV, SFTP and FTP network shares",
    "Combined libraries, watchlists and optional watch-history sync",
    "In-player file and edition switching on the active server",
    "Offline downloads and movie/episode streaming-quality controls on iPhone and iPad",
    "Dual subtitles, themes, per-profile settings and circadian mode",
    "IPTV via M3U playlists or Xtream accounts, XMLTV guides, authorized server channels and scheduled library channels",
    "Live TV guide, search, favorites, recently watched channels and up to four-channel Multiview",
    "Music playback where supported by the source",
  ],
  url: SITE,
  image: `${SITE}${SOCIAL_IMAGE_PATH}`,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  license: "https://www.gnu.org/licenses/gpl-3.0.html",
  isAccessibleForFree: true,
  author: {
    "@type": "Person",
    name: "Brandon Moore",
    url: "https://github.com/brandomoore",
  },
  sameAs: [GITHUB_URL],
};

/**
 * Names the publisher and the site as entities in their own right. Without
 * these, the only thing on the page Google can attach the brand to is the app
 * listing, which makes "Plozz" harder to resolve as a search term.
 */
const publisherLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `${SITE}/#publisher`,
  name: "Brandon Moore",
  url: "https://brando.page",
  sameAs: ["https://github.com/brandomoore"],
};

const siteLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Plozz",
  url: SITE,
  publisher: { "@id": `${SITE}/#publisher` },
};

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.q,
    acceptedAnswer: { "@type": "Answer", text: stripHtml(faq.a) },
  })),
};
---

<Layout
  title="Plozz — free, open-source media player for Apple TV"
  description="Free, open-source Infuse alternative for Apple TV, iPhone and iPad, with IPTV / Live TV, combined libraries and dual subtitles. Bring your own media."
>
  {/* The first hero slide is the LCP element. Preloading the AVIF candidate
      starts it before the parser reaches the markup near the bottom of the
      hero. Browsers without AVIF ignore a preload carrying a type they cannot
      decode, so they are not sent down a wasted fetch. */}
  <link
    slot="head"
    rel="preload"
    as="image"
    type="image/avif"
    imagesrcset={shotSrcset(heroScreenshots[0].name, "avif")}
    imagesizes={HERO}
    fetchpriority="high"
  />
  <SiteHeader />

  <main>
    <section class="hero">
      <div class="container">
        <div class="hero-copy">
          <h1>Free and open source. <br class="h1-break" />Plays practically everything.</h1>

          <div class="hero-summary">
            <div class="hero-works">
              <ul class="hero-logos">
                <li><img src="/providers/plex.svg" alt="Plex" /></li>
                <li><img src="/providers/jellyfin.svg" alt="Jellyfin" /></li>
                <li><img src="/providers/emby.png" alt="Emby" /></li>
                <li><span class="silo-lockup"><img src="/providers/silo.svg" alt="" />Silo</span></li>
                <li>
                  <span class="share-lockup">
                    <Icon name="ph:folders" />
                    Network shares
                  </span>
                </li>
                <li>
                  <span class="share-lockup">
                    <Icon name="ph:television-simple" />
                    IPTV / Live TV
                  </span>
                </li>
              </ul>
            </div>

            <div class="hero-actions">
              <div class="hero-cta">
                <a
                  class="btn btn-primary btn-lg btn-cta"
                  href={TESTFLIGHT_URL}
                  aria-label="Join the TestFlight beta"
                  target="_blank"
                  rel="noopener"
                >
                  <Icon name="simple-icons:apple" />
                  <span class="hero-cta-label-wide">Join the TestFlight beta</span>
                  <span class="hero-cta-label-compact" aria-hidden="true">TestFlight</span>
                </a>
                <a
                  class="btn btn-light btn-lg"
                  href={GITHUB_URL}
                  target="_blank"
                  rel="noopener"
                >
                  <Icon name="simple-icons:github" />
                  GitHub
                </a>
                <a
                  class="btn btn-light btn-lg"
                  href={DISCORD_URL}
                  target="_blank"
                  rel="noopener"
                >
                  <Icon name="simple-icons:discord" aria-hidden="true" />
                  Discord
                </a>
              </div>
            </div>
          </div>
        </div>
        <div class="hero-devices" data-hero-gallery>
          <div class="tv-frame device-tv">
            {
              heroScreenshots.map((screenshot, index) => (
                <Shot
                  name={screenshot.name}
                  alt={screenshot.alt}
                  sizes={HERO}
                  class:list={["hero-slide", { "is-active": index === 0 }]}
                  loading={index === 0 ? "eager" : "lazy"}
                  fetchpriority={index === 0 ? "high" : undefined}
                  defer={index === 0 ? undefined : "gallery"}
                  rest={{
                    "data-hero-slide": true,
                    "data-slide-label": screenshot.label,
                  }}
                />
              ))
            }
          </div>
          <div class="hero-gallery-status" aria-live="polite">
            <span data-gallery-label>{heroScreenshots[0].label}</span>
            <span class="hero-gallery-control">
              <span
                ><span data-gallery-index>1</span> of {
                  heroScreenshots.length
                }</span
              >
              <button type="button" data-gallery-toggle>Pause</button>
            </span>
          </div>
        </div>
      </div>
    </section>

    <section class="band" aria-labelledby="icloud-heading">
      <div class="container">
        <div class="band-head">
          <h2 id="icloud-heading">iCloud sync</h2>
        </div>

        <div class="slab icloud-slab">
          <div class="cell icloud-visual">
            <div class="icloud-devices">
              <div class="icloud-device-slot icloud-ipad-slot">
                <div
                  class="device device-ipad-pro device-spacegray device-demo-portrait"
                >
                  <div class="device-frame">
                    <Shot
                      name="plozz-demo-ipad-home"
                      alt="Plozz on iPad"
                      sizes={DEVICE_IPAD}
                      fetchpriority="low"
                      defer="viewport"
                      class="device-screen"
                    />
                  </div>
                  <div class="device-btns"></div>
                  <div class="device-sensors"></div>
                </div>
              </div>
              <div class="icloud-device-slot icloud-iphone-slot">
                <div class="device device-iphone-14-pro device-black">
                  <div class="device-frame">
                    <Shot
                      name="plozz-demo-iphone-library"
                      alt="A populated film library in Plozz on iPhone"
                      sizes={DEVICE_IPHONE}
                      fetchpriority="low"
                      defer="viewport"
                      class="device-screen"
                    />
                  </div>
                  <div class="device-stripe"></div>
                  <div class="device-header"></div>
                  <div class="device-sensors"></div>
                  <div class="device-btns"></div>
                  <div class="device-power"></div>
                  <div class="device-home"></div>
                </div>
              </div>
            </div>
          </div>
          <div class="cell">
            <h3>Synced to all of your devices</h3>
            <p>
              Sync profiles, preferences and server setup through iCloud.
              Server credentials aren’t cloud-synced. Set up another device
              from an existing one; Silo asks you to approve the new device separately.
            </p>
          </div>
          <div class="cell">
            <h3>Your profile, your layout</h3>
            <p>
              Each Plozz profile keeps its own presentation and library choices,
              with native profile switching on Apple TV. Server users still
              own their watch history and restrictions.
            </p>
          </div>
        </div>
      </div>
    </section>

    <Marquee />

    <section class="band" aria-labelledby="watching-heading">
      <div class="container">
        <div class="band-head">
          <h2 id="watching-heading">Keep watching your way.</h2>
        </div>
        <div class="slab">
          <a class="cell" href="/features#can-i-use-less-data">
            <h3>Quality for the connection</h3>
            <p>
              On iPhone and iPad, choose movie and episode quality for home,
              remote networks and cellular. Use a preset or set your own limits.
            </p>
            <span class="cell-go">Streaming quality<span class="cell-arrow" aria-hidden="true"></span></span>
          </a>
          <a class="cell" href="/features#can-i-change-versions-mid-film">
            <h3>Another file. Same player.</h3>
            <p>
              Switch files or editions on the active server without leaving
              playback. Your position and settings carry over.
            </p>
            <span class="cell-go">Version controls<span class="cell-arrow" aria-hidden="true"></span></span>
          </a>
          <a class="cell" href="/live-tv">
            <h3>Your channels. One guide.</h3>
            <p>
              Bring your own IPTV playlist or Xtream account. Browse the guide,
              save favorites and watch up to four channels together in Multiview.
            </p>
            <span class="cell-go">Explore IPTV / Live TV<span class="cell-arrow" aria-hidden="true"></span></span>
          </a>
        </div>
      </div>
    </section>

    <section class="band" aria-labelledby="plays-heading">
      <div class="container">
        <div class="band-head">
          <h2 id="plays-heading">It plays what you already have.</h2>
        </div>

        <div class="slab playback-formats" style="--cols: 6">
          <div class="cell format-third">
            <h3>HDR10</h3>
            <p>
              High-dynamic-range video on compatible devices and displays,
              with output dependent on the file and playback path.
            </p>
          </div>
          <div class="cell format-third">
            <h3>HDR10+</h3>
            <p>
              Dynamic metadata from supported files, with output dependent on
              your device, display and playback path.
            </p>
          </div>
          <div class="cell format-third">
            <h3>Dolby Digital Plus Atmos</h3>
            <p>
              E-AC-3 JOC stays intact on compatible playback paths.
            </p>
          </div>
          <div class="cell format-half">
            <h3>Every codec worth having</h3>
            <p>
              HEVC, H.264, AV1, VP9, MPEG-2, VC-1 and the rest, in MKV, MP4 or a
              Blu-ray image.
            </p>
          </div>
          <a class="cell format-half" href="/formats">
            <h3>The full list</h3>
            <p>
              Audio, subtitles and containers, with the edge cases stated
              plainly.
            </p>
            <span class="cell-go"
              >Every supported format<span class="cell-arrow" aria-hidden="true"
              ></span></span
            >
          </a>
        </div>
      </div>
    </section>

    <section class="band" aria-labelledby="merge-heading">
      <div class="container">
        <div class="band-head">
          <h2 id="merge-heading">Your servers. Your friends’. One library.</h2>
        </div>

        <div class="slab merge-slab">
          <div class="cell merge-visual">
            <Confluence />
          </div>
          <div class="cell">
            <h3>Everything in sync</h3>
            <p>
              Your servers fold into a single library. Keep each server’s
              watch history separate, or enable optional cross-server history sync.
            </p>
          </div>

          <div class="cell">
            <h3>The best version, automatically</h3>
            <p>
              Every copy is weighed on how close the server is, what your device
              plays natively, then resolution and HDR.
            </p>
          </div>
          <div class="cell">
            <h3>Play from any copy</h3>
            <p>
              Choose a source before playing when several servers have the
              same title. In-player version changes stay on that chosen server.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="band" aria-labelledby="circadian-heading">
      <div class="container">
        <div class="band-head">
          <h2 id="circadian-heading">Circadian mode</h2>
        </div>

        <div class="slab sky-slab">
          <div class="cell sky-cell">
            <CircadianLab />
          </div>
          <div class="cell">
            <CircadianDial />
            <h3>A quieter screen at night</h3>
            <p>
              Automatically tint and dim the screen following sunrise and sunset
              or a custom schedule.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="band" aria-labelledby="nopay-heading">
      <div class="container">
        <div class="band-head">
          <h2 id="nopay-heading">Everything is included.</h2>
        </div>

        <ul class="slab" style="--cols: 3">
          {
            INCLUDED.map((item) => (
              <li class="cell">
                <span class="cell-icon" aria-hidden="true">
                  <Icon name={item.icon} />
                </span>
                <h3>{item.name}</h3>
                <p>{item.detail}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="band" id="sources" aria-labelledby="sources-heading">
      <div class="container">
        <div class="band-head">
          <h2 id="sources-heading">Better on whatever you already run</h2>
        </div>

        <div class="slab" style="--cols: 3">
          <a class="cell" href="/jellyfin">
            <div class="cell-visual">
              <img
                class="lockup-jellyfin"
                src="/providers/jellyfin.svg"
                alt="Jellyfin"
              />
            </div>
            <div class="cell-foot">
              <p>Free and open source, like Plozz.</p>
              <span class="cell-go"
                >See how it works<span class="cell-arrow" aria-hidden="true"
                ></span></span
              >
            </div>
          </a>
          <a class="cell" href="/plex">
            <div class="cell-visual">
              <img class="lockup-plex" src="/providers/plex.svg" alt="Plex" />
            </div>
            <div class="cell-foot">
              <p>Subtitle search and styling in the player.</p>
              <span class="cell-go"
                >See how it works<span class="cell-arrow" aria-hidden="true"
                ></span></span
              >
            </div>
          </a>
          <a class="cell" href="/emby">
            <div class="cell-visual">
              <img class="lockup-emby" src="/providers/emby.png" alt="Emby" />
            </div>
            <div class="cell-foot">
              <p>Native libraries and playback on every device.</p>
              <span class="cell-go"
                >See how it works<span class="cell-arrow" aria-hidden="true"
                ></span></span
              >
            </div>
          </a>
          <a class="cell" href="/silo">
            <div class="cell-visual">
              <span class="silo-lockup"><img src="/providers/silo.svg" alt="" />Silo</span>
            </div>
            <div class="cell-foot">
              <p>Native Silo support, without compatibility mode.</p>
              <span class="cell-go">See how it works<span class="cell-arrow" aria-hidden="true"></span></span>
            </div>
          </a>
          <a class="cell" href="/network-shares">
            <div class="cell-visual">
              <span class="share-lockup">
                <Icon name="ph:folders" />
                Network shares
              </span>
            </div>
            <div class="cell-foot">
              <p>Connects over SMB, NFS, WebDAV, SFTP and FTP.</p>
              <span class="cell-go"
                >See how it works<span class="cell-arrow" aria-hidden="true"
                ></span></span
              >
            </div>
          </a>
          <a class="cell" href="/live-tv">
            <div class="cell-visual">
              <span class="share-lockup">
                <Icon name="ph:television-simple" />
                IPTV / Live TV
              </span>
            </div>
            <div class="cell-foot">
              <p>Your playlists, authorized server channels and scheduled library channels. No bundled channel subscription.</p>
              <span class="cell-go">See how it works<span class="cell-arrow" aria-hidden="true"></span></span>
            </div>
          </a>
        </div>
      </div>
    </section>

    <section class="donate" aria-labelledby="donate-heading">
      <div class="container">
        <div class="donate-body">
          <div class="donate-copy">
            <h2 id="donate-heading">Consider donating.</h2>
            <p>
              If you’ve enjoyed using Plozz, a donation means a lot.
              It’s free either way.
            </p>
          </div>
          <div class="donate-action">
            <ul class="donate-amounts">
              {
                DONATION_AMOUNTS.map((amount) => (
                  <li>
                    <a
                      href={`${DONATE_URL}?frequency=one-time&amount=${amount}`}
                      target="_blank"
                      rel="noopener"
                    >
                      <span class="sr-only">Sponsor </span>${amount}
                    </a>
                  </li>
                ))
              }
              <li>
                <a
                  class="donate-go"
                  href={DONATE_URL}
                  target="_blank"
                  rel="noopener"
                >
                  Donate<span class="sr-only"> another amount, or monthly</span>
                  <Icon name="ph:arrow-up-right" />
                </a>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="faq-section" id="faq" aria-labelledby="faq-heading">
      <div class="container">
        <h2 id="faq-heading">Common questions</h2>
        <div class="faq-list">
          {faqs.map((faq) => (
            <details>
              <summary>{faq.q}</summary>
              <p set:html={faq.a} />
            </details>
          ))}
        </div>
      </div>
    </section>

    <Closer />
  </main>

  <SiteFooter />

  <script type="application/ld+json" set:html={JSON.stringify(softwareLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(publisherLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(siteLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  <SiteScripts />
  <script>
    const gallery = document.querySelector("[data-hero-gallery]");

    if (gallery) {
      const slides = [...gallery.querySelectorAll("[data-hero-slide]")];
      const label = gallery.querySelector("[data-gallery-label]");
      const indexLabel = gallery.querySelector("[data-gallery-index]");
      const toggle = gallery.querySelector("[data-gallery-toggle]");
      const reducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      );
      let activeIndex = 0;
      let timer;
      let paused = reducedMotion.matches;

      /**
       * Every slide sits stacked inside the frame, so they are all in the
       * viewport and loading="lazy" would not hold any of them back. The markup
       * ships slides 2..n with their URLs parked in data-srcset/data-src, and
       * this promotes them when they are actually wanted — which keeps roughly
       * 1.4 MB off the initial load.
       *
       * The <source> elements have to be filled before the <img>, or the
       * browser will have already settled on the WebP fallback by the time the
       * AVIF candidate appears.
       */
      const hydrate = (slide) => {
        const picture = slide.closest("picture[data-deferred]");
        if (!picture) return;

        picture.querySelectorAll("source[data-srcset]").forEach((source) => {
          source.srcset = source.dataset.srcset;
          delete source.dataset.srcset;
        });

        if (slide.dataset.src) {
          slide.src = slide.dataset.src;
          delete slide.dataset.src;
        }

        delete picture.dataset.deferred;
      };

      const showSlide = (index) => {
        activeIndex = index;

        // Whatever is about to be shown must have pixels, and the one after it
        // is the next thing the timer will reach for.
        hydrate(slides[activeIndex]);
        hydrate(slides[(activeIndex + 1) % slides.length]);

        slides.forEach((slide, slideIndex) => {
          slide.classList.toggle("is-active", slideIndex === activeIndex);
        });

        label.textContent = slides[activeIndex].dataset.slideLabel;
        indexLabel.textContent = String(activeIndex + 1);
      };

      /**
       * Advance, but only onto a slide that has actually arrived.
       *
       * Every slide that becomes visible is a fresh largest-contentful-paint
       * candidate, so rotating onto one that is still downloading pushes LCP
       * out to whenever that image finally lands — it measured 44s on Slow 3G.
       * Waiting also avoids cross-fading to a blank frame. The next slide is
       * hydrated well ahead of its turn, so on any normal connection this is
       * ready and the rotation is unaffected.
       */
      const advance = () => {
        const next = (activeIndex + 1) % slides.length;
        hydrate(slides[next]);
        if (!slides[next].complete) return;
        showSlide(next);
      };

      const stop = () => {
        window.clearInterval(timer);
      };

      const start = () => {
        stop();
        if (paused || document.hidden || reducedMotion.matches) return;
        timer = window.setInterval(advance, 5000);
      };

      toggle.addEventListener("click", () => {
        paused = !paused;
        toggle.textContent = paused ? "Play" : "Pause";

        // Starting from a pause means the next slide may still be inert — on
        // the saveData path nothing was ever warmed. Fetch it now rather than
        // letting the timer cross-fade to an image that has not arrived.
        if (!paused) hydrate(slides[(activeIndex + 1) % slides.length]);

        start();
      });

      /*
       * Hovering does not stop the rotation. The pointer spends most of its
       * time over the hero simply because the hero is the biggest thing on the
       * screen, so pausing there stops the gallery for people who never asked
       * for it and leaves the shot sitting on one slide.
       *
       * Focus does not stop it either. The only focusable thing inside the
       * gallery is the Pause button, so a focus rule amounts to "paused while
       * the Pause button is focused" — which nothing about the button's own
       * label would tell you. The button stays the way to stop it, and now it
       * is the only way, so what it reads is always what is happening.
       */
      document.addEventListener("visibilitychange", start);
      reducedMotion.addEventListener("change", () => {
        if (reducedMotion.matches) {
          paused = true;
          toggle.textContent = "Play";
        }
        start();
      });

      toggle.textContent = paused ? "Play" : "Pause";

      /**
       * The gallery does not start on its own — it waits for the visitor to do
       * something first.
       *
       * Every slide that rotates into view is a fresh
       * largest-contentful-paint candidate, so a carousel that starts on a
       * timer keeps moving the page's LCP later and later: rotating at the
       * five second mark measured LCP at 5.98s on a 4G desktop, against 0.9s
       * for the hero image it had already finished painting. Largest
       * contentful paint is finalised at the first user input, so holding the
       * rotation until then means the gallery cannot inflate it, in the lab or
       * in the field.
       *
       * In practice this costs nothing: a pointer move, a scroll or a keypress
       * all count, and one of those lands within a second or two of arrival.
       * Someone who never interacts sees the first slide, which is a complete
       * picture of the app on its own.
       *
       * The next slide is fetched at the same moment, so it is ready well
       * before the first five second tick.
       */
      const ENGAGEMENT = ["pointerdown", "pointermove", "keydown", "wheel", "touchstart", "scroll"];
      let armed = false;

      const arm = () => {
        if (armed) return;
        armed = true;
        for (const type of ENGAGEMENT) {
          window.removeEventListener(type, arm, { capture: true });
        }
        hydrate(slides[1 % slides.length]);
        start();
      };

      /*
       * On a metered or genuinely slow connection none of it is worth the
       * bytes: the gallery stays on the first slide until it is asked for by
       * hand.
       */
      const connection = navigator.connection;
      const frugal = Boolean(
        connection &&
          (connection.saveData ||
            /^(slow-)?2g$/.test(connection.effectiveType || "") ||
            (typeof connection.downlink === "number" && connection.downlink > 0 && connection.downlink < 1.5)),
      );

      if (frugal) {
        paused = true;
        toggle.textContent = "Play";
        armed = true;
        stop();
      } else if (!paused) {
        for (const type of ENGAGEMENT) {
          window.addEventListener(type, arm, { capture: true, passive: true, once: false });
        }
      }
    }
  </script>
</Layout>

<style>
  @media (min-width: 901px) {
    .playback-formats > .format-third {
      grid-column: span 2;
    }

    .playback-formats > .format-half {
      grid-column: span 3;
    }
  }
</style>
