---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Closer from '../components/Closer.astro';
import SiteScripts from '../components/SiteScripts.astro';
import PageHero from '../components/PageHero.astro';
import Showcase from '../components/Showcase.astro';
import FactSection from '../components/FactSection.astro';
import Shot from "../components/Shot.astro";
import { FIGURE } from "../data/imageSizes";

const title = "Plex client for Apple TV, iPhone and iPad — Plozz";
const description = "A free Plex client for Apple TV, iPhone and iPad. Version switching, mobile streaming quality and downloads, dual subtitles and Plex Common Sense Media guidance.";

const compatibility = [
  {
    "name": "Video",
    "chips": [
      "HEVC",
      "H.264",
      "VP9",
      "AV1"
    ]
  },
  {
    "name": "HDR",
    "chips": [
      "Dolby Vision P5",
      "Dolby Vision P8",
      "HDR10",
      "HLG"
    ]
  },
  {
    "name": "Badges",
    "chips": [
      "Dolby Vision",
      "Atmos",
      "Digital+",
      "DTS",
      "4K",
      "5.1",
      "7.1"
    ]
  },
  {
    "name": "Scrub thumbnails",
    "value": "Plex BIF thumbnails."
  },
  {
    "name": "One library",
    "value": "Merges with Jellyfin, Emby, Silo and network shares, or keeps its own rows."
  }
];
---

<Layout title={title} description={description}>
  <SiteHeader />

  <main>
    <PageHero
      eyebrow={"Plex"}
      title={"Your Plex library. Your player."}
    />

    <Showcase
      question={"Does it play the original?"}
      detail="Original-file playback keeps compatible media on the device. Mobile quality limits can request a server conversion instead; Plex settings and entitlements still apply."
    >
      <ul class="proof">
        <li><span>Dolby Vision</span><span>Profiles 5, 7, 8.1 and 8.4</span></li>
        <li><span>TrueHD Atmos and DTS:X</span><span>Height channels rendered through AetherEngine on supported Apple TV setups</span></li>
        <li><span>Dolby Digital Plus Atmos</span><span>E-AC-3 JOC stream copy on compatible paths</span></li>
        <li><span>TrueHD and DTS-HD MA</span><span>Channel-based surround or lossless FLAC, separate from height rendering</span></li>
        <li><span>Your server</span><span>Direct play when possible, conversion when needed</span></li>
      </ul>
    </Showcase>

    <Showcase
      question={"Can I make the subtitles readable?"}
      detail="Pick a font, adjust position in 0.5% steps or display two tracks at once. Subtitle search stays in the player."
      flip
    >
      <Shot
        name="plozz-tv-subtitles"
        alt="The subtitle style panel open during playback, with OpenDyslexic selected and the subtitle rendered in it"
        sizes={FIGURE}
        class="shot"
      />
    </Showcase>

    <Showcase
      question={"What you get with Plex"}
    >
      <ul class="proof">
        <li><span>Subtitle search</span><span>Find and load one from inside the player</span></li>
        <li><span>Subtitle styling</span><span>Always yours, never the server’s</span></li>
        <li><span>Skip intros</span><span>Reads the markers your server provides</span></li>
        <li><span>Plex Home</span><span>Server users keep their own history and restrictions, separate from Plozz profiles</span></li>
      </ul>
    </Showcase>

    <Showcase
      question="Is that an age recommendation or a review score?"
      detail="They’re separate. Plex movie and show details can show Common Sense Media’s recommended age alongside review scores. Choose age visibility and review-score visibility independently."
      flip
    >
      <ul class="proof">
        <li><span>Recommended age</span><span>Plex-provided Common Sense Media guidance</span></li>
        <li><span>Topic details</span><span>Requires an eligible active Plex user with Plex Pass access</span></li>
        <li><span>Review scores</span><span>Choose sources, priority and the number shown</span></li>
        <li><span>Provider scope</span><span>Common Sense Media is Plex-only, not a feature of every server</span></li>
      </ul>
    </Showcase>

    <FactSection
      title="More ways to watch"
      facts={[
        { name: 'Quality on iPhone and iPad', value: 'Movie and episode presets or Custom resolution and total-bitrate limits, saved per Plozz profile for local, remote Wi-Fi/Ethernet and cellular connections.' },
        { name: 'Original or converted', value: 'Keep the original when it fits. Automatic and codec preferences use supported server conversion; hardware transcoding generally needs Plex Pass. HDR and audio can change.' },
        { name: 'Offline on mobile', value: 'Download films and episodes on iPhone and iPad, subject to the server’s permissions and capabilities.' },
        { name: 'Change versions', value: 'Choose another file or edition on the active account in the TV or mobile player. Position and playback settings carry over, but different cuts needn’t share the same timeline.' },
        { name: 'Libraries and extras', value: 'Collections, bonus videos and A–Z jumps in name-sorted individual or combined libraries.' },
        { name: 'Current stream info', value: 'See measured conversion dimensions, codecs and audio when known, separately from original-file metadata and selected quality limits.' },
      ]}
    />

    <FactSection
      title="Compatibility"
      facts={compatibility}
    />

    <Closer secondaryHref="/features" secondaryLabel="The questions people ask" />
  </main>

  <SiteFooter />
  <SiteScripts />
</Layout>
