---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Closer from '../components/Closer.astro';
import SiteScripts from '../components/SiteScripts.astro';
import PageHero from '../components/PageHero.astro';
import Showcase from '../components/Showcase.astro';
import FactSection from '../components/FactSection.astro';
import Shot from "../components/Shot.astro";
import { FIGURE } from "../data/imageSizes";
import { DOCS_URL } from '../data/site';

const title = "Jellyfin client for Apple TV, iPhone and iPad — Plozz";
const description = "A free Jellyfin client for Apple TV, iPhone and iPad. Original-file playback, mobile streaming-quality controls, offline downloads, dual subtitles and combined libraries.";

const compatibility = [
  {
    "name": "Video",
    "chips": [
      "HEVC",
      "H.264",
      "VP9",
      "AV1"
    ]
  },
  {
    "name": "HDR",
    "chips": [
      "Dolby Vision P5",
      "Dolby Vision P8",
      "HDR10",
      "HLG"
    ]
  },
  {
    "name": "Subtitles",
    "chips": [
      "SRT",
      "ASS",
      "SSA",
      "VTT",
      "PGS",
      "DVB",
      "DVD"
    ]
  },
  {
    "name": "Scrub thumbnails",
    "value": "Jellyfin trickplay tiles."
  },
  {
    "name": "One library",
    "value": "Merges with Plex, Emby, Silo and network shares, or keeps its own rows."
  }
];
---

<Layout title={title} description={description}>
  <SiteHeader />

  <main>
    <PageHero
      eyebrow={"Jellyfin"}
      title={"Your Jellyfin library, on every screen."}
    />

    <Showcase
      question={"Does it play the original?"}
      detail="Plozz plays a broad range of original files on the device. Choose a lower streaming-quality limit on iPhone or iPad when you need the server to convert instead."
    >
      <ul class="proof">
        <li><span>Dolby Vision</span><span>Profiles 5, 7, 8.1 and 8.4</span></li>
        <li><span>Dolby Digital Plus Atmos</span><span>E-AC-3 JOC stream copy on compatible paths</span></li>
        <li><span>TrueHD and DTS-HD MA</span><span>Channel-based surround or lossless FLAC</span></li>
        <li><span>Your server</span><span>Original delivery when possible; conversion when required</span></li>
      </ul>
    </Showcase>

    <Showcase
      question={"Can I make the subtitles readable?"}
      detail="Style two simultaneous tracks, adjust position in 0.5% steps, or search and download a missing subtitle. A File match badge appears when Jellyfin confirms a match to the video."
      flip
    >
      <Shot
        name="plozz-tv-subtitles"
        alt="The subtitle style panel open during playback, with OpenDyslexic selected and the subtitle rendered in it"
        sizes={FIGURE}
        class="shot"
      />
    </Showcase>

    <Showcase
      question={"Does it skip intros?"}
      detail="When your Jellyfin server provides intro and credit markers."
    >
      <ul class="proof">
        <li><span>Off</span><span>Never touch it</span></li>
        <li><span>On</span><span>Show a Skip button</span></li>
        <li><span>Auto (delay)</span><span>Skip after five seconds, cancellable</span></li>
        <li><span>Auto (instant)</span><span>Gone before you notice</span></li>
      </ul>
    </Showcase>

    <FactSection
      title="Beyond direct play"
      facts={[
        { name: 'Mobile quality', value: 'iPhone/iPad movies and episodes get per-network presets or Custom resolution and total bitrate. Local and remote networks default to Maximum; cellular starts at 720p / 2 Mbps.' },
        { name: 'Conversion choices', value: 'Automatic, Prefer HEVC or Prefer H.264 where supported. Server configuration, encoder support and permissions apply; HDR conversion isn’t guaranteed.' },
        { name: 'Offline downloads', value: 'Save films and episodes on iPhone and iPad. Download quality is separate from streaming quality.' },
        { name: 'Versions in the player', value: 'Change files or editions on the active Jellyfin account, keeping position, pause state, speed, quality and matching tracks. Different cuts may have different timelines.' },
        { name: 'Find your place', value: 'A–Z navigation in name-sorted libraries, collections, extras and a combined watchlist.' },
        { name: 'Your server user', value: 'Jellyfin owns permissions and watch history. Plozz profiles separately control presentation and which libraries appear.' },
      ]}
    />

    <FactSection
      title="Compatibility"
      facts={compatibility}
    />

    <Closer secondaryHref={`${DOCS_URL}/servers/`} secondaryLabel="Jellyfin setup guide" />
  </main>

  <SiteFooter />
  <SiteScripts />
</Layout>
