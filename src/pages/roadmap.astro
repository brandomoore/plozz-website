---
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteScripts from '../components/SiteScripts.astro';
import { STAGES } from '../../shared/roadmap.mjs';
import '../styles/roadmap.css';

const icons = ['ph:stack', 'ph:circle', 'ph:circle-half', 'ph:flask', 'ph:check-circle'];
---

<Layout title="Roadmap — Plozz" description="Follow Plozz's bugs and feature requests, from community backlog to verified App Store releases.">
  <a class="roadmap-skip" href="#roadmap">Skip to roadmap</a>
  <SiteHeader />
  <main id="roadmap" class="roadmap-shell">
    <div class="roadmap-heading">
      <div>
        <h1>Roadmap<span aria-hidden="true">.</span></h1>
      </div>
      <div class="roadmap-actions">
        <a class="roadmap-feedback" href="https://github.com/brandomoore/Plozz/issues/new/choose" aria-label="Suggest a feature or report a bug">
          Suggest <Icon name="ph:arrow-up-right" aria-hidden="true" />
        </a>
        <a class="roadmap-feedback" href="https://plozz.app/auth/roadmap/login" data-roadmap-login aria-label="Sign in with GitHub to edit the roadmap">
          <Icon name="ph:pencil-simple" aria-hidden="true" /> Edit
        </a>
        <button class="roadmap-feedback" type="button" data-roadmap-logout hidden>Sign out</button>
      </div>
    </div>

    <form class="roadmap-toolbar" role="search" aria-label="Filter roadmap" data-roadmap-filters>
      <label class="roadmap-search">
        <Icon name="ph:magnifying-glass" aria-hidden="true" />
        <span class="sr-only">Search roadmap</span>
        <input type="search" name="q" placeholder="Search issues or ideas" autocomplete="off" maxlength="200" />
      </label>
      <fieldset class="roadmap-kinds" disabled>
        <legend class="sr-only">Item type</legend>
        {[['all', 'All', null], ['feature', 'Features', 'ph:lightbulb'], ['bug', 'Bugs', 'ph:bug']].map(([value, label, icon]) => (
          <label>
            <input type="radio" name="kind" value={value} aria-label={label} checked={value === 'all'} />
            <span title={label}>
              {icon && <Icon name={icon} is:inline data-kind-icon={value} aria-hidden="true" focusable="false" />}
              {label}
            </span>
          </label>
        ))}
      </fieldset>
      <span class="roadmap-order">Blocking and Major first</span>
    </form>

    <div class="roadmap-state">
      <p data-roadmap-status role="status" aria-live="polite">Loading the roadmap…</p>
      <button class="roadmap-refresh" type="button" data-roadmap-refresh hidden>Retry</button>
    </div>
    <p class="roadmap-preview-notice" data-roadmap-preview hidden>
      Preview using a verified snapshot.
    </p>
    <p class="roadmap-editor-status" data-editor-status role="status" aria-live="polite" hidden></p>
    <template data-card-icons>
      <Icon name="simple-icons:discord" is:inline data-card-icon="discord" aria-hidden="true" focusable="false" />
      <Icon name="ph:dots-three-bold" is:inline data-card-icon="actions" aria-hidden="true" focusable="false" />
    </template>
    <dialog class="roadmap-card-dialog" data-card-dialog aria-labelledby="card-dialog-title">
      <div class="roadmap-dialog-heading">
        <h2 id="card-dialog-title"></h2>
        <button type="button" class="roadmap-icon-button" data-dialog-close aria-label="Close card menu">
          <Icon name="ph:x" aria-hidden="true" />
        </button>
      </div>
      <div data-dialog-body></div>
    </dialog>
    <div class="roadmap-mobile-stages" role="group" aria-label="Show a roadmap stage">
      {STAGES.map(stage => (
        <button type="button" data-stage-select={stage.id} aria-pressed={stage.id === 'backlog'} disabled>
          {stage.label}<span data-mobile-count={stage.id}>—</span>
        </button>
      ))}
    </div>

    <div class="roadmap-board" data-roadmap-board aria-busy="true">
      {STAGES.map((stage, index) => (
        <section class="roadmap-column" data-stage={stage.id} data-mobile-active={stage.id === 'backlog' ? '' : undefined} aria-labelledby={`heading-${stage.id}`}>
          <header class="roadmap-column-heading">
            <div>
              <Icon name={icons[index]} aria-hidden="true" />
              <h2 id={`heading-${stage.id}`}>{stage.label}</h2>
              <span class="roadmap-count" data-count aria-label="Count loading">—</span>
            </div>
            {stage.description && <p>{stage.description}</p>}
          </header>
          <div class="roadmap-scroll" data-scroll tabindex="0" role="region" aria-label={`${stage.label} items`}>
            <ul class="roadmap-cards" data-cards>
              <li class="roadmap-placeholder" aria-hidden="true"><span></span><span></span><span></span></li>
              <li class="roadmap-placeholder" aria-hidden="true"><span></span><span></span></li>
            </ul>
            <div class="roadmap-empty" data-empty hidden>
              <Icon name={icons[index]} aria-hidden="true" />
              <p></p>
            </div>
          </div>
        </section>
      ))}
    </div>

    <div class="roadmap-bottom">
      <details class="roadmap-about">
        <summary>How this board works</summary>
        <div>
          <p>GitHub is the source of truth. Updates are scheduled about every 15 minutes. Scroll each column to see every item. Search and filters cover the whole board.</p>
          <p>Blocking means a core task cannot be completed. Major means it is seriously impaired. Active columns show these first, then newest issues. Triage assesses reported impact, not confirmed reproduction. Unmarked items may not yet be assessed.</p>
          <p>Sign in as the maintainer to drag cards or choose a stage from their menu. Changes are saved to GitHub; the public board catches up after the next successful sync.</p>
          <p>Your severity override stays in place until you choose Automatic. Severity never moves an item to Planned or proves delivery.</p>
          <p>Planned and In progress are maintainer decisions, without promised dates. TestFlight and Released mean availability on every affected platform, verified automatically or confirmed by Brandon. A merge or closed issue isn’t proof of delivery.</p>
          <p>Duplicates and closed issues without delivery evidence or maintainer confirmation aren’t shown. Bug-assessment labels don’t change roadmap commitments.</p>
          <p data-roadmap-evidence hidden></p>
          <a href="https://github.com/brandomoore/Plozz/issues">Browse all GitHub issues <span aria-hidden="true">↗</span></a>
        </div>
      </details>
    </div>
    <noscript>
      <p class="roadmap-noscript">Enable JavaScript to load and filter the board, or <a href="https://github.com/brandomoore/Plozz/issues">browse the issues on GitHub</a>.</p>
      <style>.roadmap-board, .roadmap-toolbar, .roadmap-state, .roadmap-mobile-stages { display: none; }</style>
    </noscript>
  </main>
  <SiteFooter />
  <SiteScripts />
</Layout>

<script>
  import '../scripts/roadmap.js';
</script>
