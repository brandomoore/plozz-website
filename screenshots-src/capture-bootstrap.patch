@@ -3088 +3090 @@ struct PlozziOSScreenshotRouter: View {
-        case let .play(title, seconds, pause):
+        case let .play(title, seconds, pause, panel):
@@ -3095,0 +3098 @@ struct PlozziOSScreenshotRouter: View {
+            PlozziOSScreenshotSeed.pendingPlayerPanel = panel
@@ -3097,0 +3101,19 @@ struct PlozziOSScreenshotRouter: View {
+        case let .download(title):
+            guard let item = await find(title),
+                  let provider = appModel.provider(for: item) else { return notFound }
+            do {
+                let queued = try await appModel.downloads.enqueue(item: item, provider: provider, quality: .original)
+                for _ in 0..<360 {
+                    try Task.checkCancellation()
+                    if let current = appModel.downloads.records.first(where: { $0.identityKey == queued.identityKey }) {
+                        if current.status == .completed { return "ok" }
+                        if current.status == .failed { return "downloadFailed" }
+                    }
+                    try await Task.sleep(for: .milliseconds(250))
+                }
+                return "downloadTimeout"
+            } catch {
+                PlozzLog.boot("Screenshot download request failed")
+                return "downloadFailed"
+            }
+
