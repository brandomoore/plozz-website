{
  "name": "plozz-website",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Marketing site for Plozz \u2014 a free, open-source media and IPTV / Live TV player for Apple TV, iPhone and iPad.",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "test": "node --test tests/*.test.mjs",
    "test:site": "npm run build && node --test tests/site/*.test.mjs",
    "worker:dev": "wrangler dev --config wrangler.worker.toml --local",
    "worker:check": "wrangler versions upload --config wrangler.worker.toml --dry-run",
    "worker:upload": "npm run build && npm test && wrangler versions upload --config wrangler.worker.toml --keep-vars",
    "worker:deploy": "wrangler versions deploy --config wrangler.worker.toml",
    "preview": "astro preview",
    "images": "node tools/build-images.mjs",
    "shots": "node tools/sync-shots.mjs",
    "fonts": "PLOZZ_FONT_PREVIEW=1 astro dev",
    "font-sheet": "node tools/font-sheet.mjs",
    "og": "node tools/build-og.mjs",
    "astro": "astro"
  },
  "devDependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.0.2",
    "wrangler": "4.133.0"
  },
  "dependencies": {
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/simple-icons": "^1.2.87",
    "astro-icon": "^1.1.5"
  }
}
